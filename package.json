{
  "name": "yt-intel",
  "version": "0.1.0",
  "private": true,
  "description": "Private YouTube research workspace — ingest videos, pull existing captions, run one structured AI analysis, store forever.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "probe:captions": "tsx scripts/probe-captions.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "yt:uploads": "tsx scripts/list-uploads.ts",
    "ingest": "tsx scripts/ingest.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "mysql2": "^3.12.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "youtubei.js": "^13.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
