# ---------------------------------------------------------------------------
# Copy to .env for local dev. Never commit .env.
# On Hostinger these go in hPanel → your app → Environment Variables.
# Env var changes there require a REDEPLOY, not just a restart.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# hPanel → Databases → MySQL Databases.
#   LIVE APP  : host is localhost      (this is what the deployed app uses)
#   LOCAL DEV : host is the Remote MySQL host shown in hPanel → Remote MySQL,
#               e.g. srv1724.hstgr.io. You must also whitelist your public IP
#               there, and re-whitelist it whenever your ISP rotates it.
# If the hostname gives ECONNREFUSED with confirmed-correct credentials, try the
# raw IP instead — DNS/IPv6 flakiness on Hostinger is a recurring theme.
# WARNING: changing this MySQL user's password silently breaks the LIVE app,
# which then serves a generic "Application error" page. Update both, then redeploy.
DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Optional. Hostinger caps concurrent connections per user; 8 leaves headroom
# for the web process and tsx scripts to coexist.
DB_CONNECTION_LIMIT=8

# Seed -----------------------------------------------------------------------
# The single v1 user (PLAN.md §0). Used by `npm run db:seed` only.
ADMIN_EMAIL=you@example.com
