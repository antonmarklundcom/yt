# ---------------------------------------------------------------------------
# Copy to .env for local dev. Never commit .env.
# On Hostinger these go in hPanel → your app → Environment Variables.
# Env var changes there require a REDEPLOY, not just a restart.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# hPanel → Databases → MySQL Databases.
#   LIVE APP  : host is localhost      (this is what the deployed app uses)
#   LOCAL DEV : host is the Remote MySQL host shown in hPanel → Remote MySQL,
#               e.g. srv1724.hstgr.io. You must also whitelist your public IP
#               there, and re-whitelist it whenever your ISP rotates it.
# If the hostname gives ECONNREFUSED with confirmed-correct credentials, try the
# raw IP instead — DNS/IPv6 flakiness on Hostinger is a recurring theme.
# WARNING: changing this MySQL user's password silently breaks the LIVE app,
# which then serves a generic "Application error" page. Update both, then redeploy.
DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Optional. Hostinger caps concurrent connections per user; 8 leaves headroom
# for the web process and tsx scripts to coexist.
DB_CONNECTION_LIMIT=8

# Seed -----------------------------------------------------------------------
# The single v1 user (PLAN.md §0). Used by `npm run db:seed` only.
ADMIN_EMAIL=you@example.com

# YouTube Data API ----------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → Create API key,
# with "YouTube Data API v3" enabled for the project.
# Free quota is 10,000 units/day. This client never calls search.list (100 units)
# — a channel's uploads cost 2 units via its uploads playlist instead. See
# src/lib/youtube/quota.ts.
YOUTUBE_API_KEY=

# Optional. Per-run guard against a runaway loop; not a real daily ledger.
YOUTUBE_QUOTA_BUDGET=10000

# Captions -------------------------------------------------------------------
# Ordered strategy list. Set this to the value printed by a PASSING
# `npm run probe:captions` run on Hostinger, so the pipeline stops paying the
# latency of strategies known to be dead on that host. Unset = try all, in the
# default order from src/lib/youtube/captions/index.ts.
# CAPTION_STRATEGIES=innertube-android,innertube-ios,watch-page

# Preferred caption languages, best first. Manual captions always beat
# auto-generated ones regardless of this setting.
CAPTION_LANGUAGES=en

# Pause between videos in a batch. Hammering YouTube from a datacenter IP is the
# fastest way to turn a working PR-01 into a blocked one, and a poll run has
# nobody waiting on it. Set 0 for a single interactive fetch.
CAPTION_DELAY_MS=1500

# Anthropic API --------------------------------------------------------------
# console.anthropic.com → API keys.
# PLAN.md §1: Haiku 4.5 is the default analysis model (~$0.02 per 30-min video);
# Sonnet 5 is a per-video opt-in via `--model sonnet`.
ANTHROPIC_API_KEY=

# Spend guard ----------------------------------------------------------------
# Hard monthly cap in USD (PLAN.md §0 — replaces the per-video approval modal).
# The poller and backfill REFUSE to start a batch whose estimate would exceed
# this; they do not stop halfway. Set to 0 to block all spend.
# PLAN.md §1 projects ~$6-12/month at 10h/day of video, so 25 leaves headroom.
MONTHLY_SPEND_CAP_USD=25
